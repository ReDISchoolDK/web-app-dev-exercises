{
	// routeTree.gen.ts is generated by TanStack Router — never edit it by hand.
	"files.watcherExclude": {
		"**/routeTree.gen.ts": true
	},
	"search.exclude": {
		"**/routeTree.gen.ts": true
	},
	"files.readonlyInclude": {
		"**/routeTree.gen.ts": true
	},

	// Format and organize imports on every save. Requires the Biome extension
	// (see .vscode/extensions.json).
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.biome": "explicit",
		// Separate action from fixAll — needed for the organizeImports assist
		// enabled in biome.json.
		"source.organizeImports.biome": "explicit"
	},

	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	// package.json, pnpm-lock and skills-lock.json sit outside Biome's
	// `files.includes`, so VS Code's built-in JSON formatter handles them.
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	// tsconfig.json, wrangler.jsonc and components.json ARE in Biome's scope.
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},

	// Use the TypeScript version pinned in package.json (6.x) rather than the
	// one bundled with VS Code, so the editor and `pnpm typecheck` agree.
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,

	// Tailwind v4 is configured in CSS, so at-rules like @theme, @apply,
	// @custom-variant and @plugin are valid. Stop the built-in CSS linter
	// from flagging them as unknown.
	"css.lint.unknownAtRules": "ignore",
	"scss.lint.unknownAtRules": "ignore",
	"less.lint.unknownAtRules": "ignore",

	// Tailwind IntelliSense: autocomplete inside className strings and inside
	// the class-building helpers this project uses.
	"editor.quickSuggestions": {
		"strings": "on"
	},
	"tailwindCSS.classFunctions": ["cva", "cn", "clsx", "twMerge"]
}
