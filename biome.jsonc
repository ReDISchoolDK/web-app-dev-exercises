{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/bridge/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"**/tsconfig.json",
			"**/components.json",
			"**/wrangler.jsonc",
			// Generated by TanStack Router — never hand-edited, never linted.
			"!**/src/routeTree.gen.ts",
			// DO NOT REMOVE. shadcn components are vendored upstream code and
			// they fail Biome's recommended rules — label.tsx trips
			// a11y/noLabelWithoutControl, field.tsx trips a11y/useSemanticElements
			// and suspicious/noDoubleEquals. This bites the forms/login exercise,
			// which needs field.tsx and label.tsx. Re-adding this folder breaks
			// `pnpm check` and CI on any branch that has run `shadcn add`.
			"!**/src/components/ui/**/*",
			"!**/src/index.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"json": {
		"parser": {
			"allowComments": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
